# PostgreSQL connection settings. DATABASE_URL may be used instead.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=smart_meal
PGUSER=postgres
PGPASSWORD=replace-with-your-postgres-password
PGSSL=false
# Use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5000
# Keep false in production; when true, registration may request admin or ngo roles.
ALLOW_PRIVILEGED_REGISTRATION=false
# Comma-separated frontend origins
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
